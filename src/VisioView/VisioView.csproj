<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VisioView.Core\VisioView.Core.csproj" />
    <!-- 同一个 ico 嵌成 WPF 资源，供窗口标题栏图标使用 -->
    <Resource Include="../../assets/VisioView.ico" Link="Assets/VisioView.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>VisioView</AssemblyTitle>
    <AssemblyName>VisioView</AssemblyName>
    <ApplicationDisplayName>VisioView</ApplicationDisplayName>
    <Product>VisioView</Product>
    <Description>轻量 .vsdx（Visio）查看器，支持导出 PNG / JPEG</Description>
    <Version>1.4.0</Version>
    <FileVersion>1.4.0.0</FileVersion>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <RootNamespace>VisioView</RootNamespace>
    <!-- 写入 exe 的 Win32 图标资源（资源管理器 / 任务栏 / 文件关联显示的就是它） -->
    <ApplicationIcon>../../assets/VisioView.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 单文件自包含发布配置（dotnet publish 时生效） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
